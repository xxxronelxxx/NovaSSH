app/lib/bridge/*.g.dart

# Release artefacts
/dist/
/dist/*.zip

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
*.log

# Exported profiles contain server passwords in plain text
*.novaprof

# Local WinSCP import file contains real sessions and encrypted passwords
/WinSCP.ini

# Android release signing keys (never commit)
/keys/
/app/android/key.properties

# badge-maker tooling
/tools/badges/node_modules/

# local UI preview screenshots
.playwright-mcp/
