<?xml version="1.0" encoding="utf-8"?>
<!--
  The profile holds servers, the PIN-encrypted vault and the edit cache. It must
  never leave the device through cloud backup or device-to-device transfer: a
  copied vault with a 4-digit PIN can be brute-forced offline in minutes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
